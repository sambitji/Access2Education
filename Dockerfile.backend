FROM python:3.12-slim

WORKDIR /app

COPY Backend/requirements_backend.txt ./
RUN pip install --no-cache-dir -r requirements_backend.txt

COPY Backend/ ./
COPY ML/ ./ML/

EXPOSE 8000

# Production command using Gunicorn for Django WSGI application
CMD ["gunicorn", "-w", "4", "django_project.wsgi:application", "--bind", "0.0.0.0:8000", "--timeout", "120"]
